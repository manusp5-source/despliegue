# Caddy issues and renews certificates on its own. Nothing to touch here.

{$DOMINIO_CRM} {
	reverse_proxy crm:3000

	# The WhatsApp webhook and the integration endpoints authenticate via a
	# shared secret, so they're exposed to the internet by necessity.
	# A per-IP limit stops anyone from brute-forcing secrets.
	rate_limit {
		zone integraciones {
			match {
				path /api/integrations/* /api/webhooks/* /api/reminders/process
			}
			key {remote_host}
			events 60
			window 1m
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	encode gzip
}

{$DOMINIO_N8N} {
	reverse_proxy n8n:5678
	header -Server
}

{$DOMINIO_LANGFUSE} {
	reverse_proxy langfuse:3000
	header -Server
}
