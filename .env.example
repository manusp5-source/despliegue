# Copia a .env y rellena. El .env NUNCA se versiona.
#
# Los secretos se generan con:
#   openssl rand -base64 32

# ---- dominios ----
DOMINIO_CRM=crm.tuclinica.es
DOMINIO_N8N=n8n.tuclinica.es
DOMINIO_LANGFUSE=logs.tuclinica.es

# ---- base de datos ----
POSTGRES_USER=agendia
POSTGRES_PASSWORD=
POSTGRES_DB=unicornia_crm

# ---- CRM ----
NEXTAUTH_SECRET=
ENCRYPTION_KEY=
# Sal de derivacion. Si se cambia, lo ya cifrado deja de poder descifrarse.
ENCRYPTION_SALT=
# El mismo valor va en CRM_CRON_SECRET dentro de n8n: tienen que coincidir.
CRON_SECRET=
CLINIC_NAME=
REMINDER_OFFSETS_HOURS=24,2

# ---- WhatsApp ----
# Vacios = canal apagado. El sistema sigue funcionando: avisa para llamar.
WHATSAPP_WEBHOOK_SECRET=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ---- n8n ----
N8N_USER=admin
N8N_PASSWORD=
# Si se pierde, las credenciales guardadas dentro de n8n son irrecuperables.
N8N_ENCRYPTION_KEY=

# ---- Langfuse ----
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=

# ---- avisos ----
ALERT_FROM=
ALERT_TO=

# ---- almacenamiento ----
MINIO_USER=agendia
MINIO_PASSWORD=

# ---- integraciones de los workflows ----
GOOGLE_PLACE_ID=
GOOGLE_PLACES_KEY=
SHEET_FACTURAS=
SHEET_MATERIAL=
DRIVE_ENTRADA=
DRIVE_ARCHIVO=
